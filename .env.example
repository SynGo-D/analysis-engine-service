ENVIRONMENT=development
PORT=8000

# -----------------------------------------------------------------------
# Database (see docker-compose.yml — mapped to host port 5434, its own
# database, to avoid conflicting with integration-service's native
# Postgres on 5432 and webhook-listener's containerized Postgres on 5433)
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=analysis_engine_db
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------
# RabbitMQ — MUST point at the same shared broker webhook-listener
# publishes to (its docker-compose stands this up on :5672), not a
# separate instance. This service consumes from pr_queue, which only
# exists on that broker.
# -----------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
